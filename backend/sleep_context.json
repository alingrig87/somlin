  "corePrinciples": {
    "routine": {
      "title": "Rutina trebuie să fie identică mereu",
      "description": "Rutina de culcare trebuie să fie exact aceeași în fiecare seară, fără excepții. Aceasta ajută creierul copilului să recunoască semnalele de somn și să pregătească organismul pentru odihnă.",
      "importance": "critical"
    },
    "quietPlay": {
      "title": "Perioadă liniștită de joc",
      "description": "Înainte de rutina de culcare, trebuie să existe o perioadă de joc liniștit, fără activități stimulante. Aceasta ajută copilul să se calmeze treptat.",
      "duration": "30-60 minute înainte de rutină",
      "importance": "high"
    },
    "lighting": {
      "title": "Fără lumini extreme în casă",
      "description": "Luminile din casă trebuie să fie estomate înainte de culcare. Evită lumini strălucitoare, ecrane și surse de lumină albastră care pot inhiba producția de melatonină.",
      "importance": "high"
    },
    "quietReading": {
      "title": "Citit în liniște",
      "description": "Cititul unei povești înainte de somn este o activitate excelentă care ajută la relaxare și crește legătura părinte-copil.",
      "importance": "high"
    },
    "stayInRoom": {
      "title": "Nu se lasă să iasă din cameră după ce începe să adoarmă",
      "description": "Odată ce rutina de culcare a început și copilul începe să adoarmă, nu trebuie lăsat să iasă din cameră. Dacă încearcă să plece, să aprindă becul, să se joace sau orice altceva, trebuie să fie pus înapoi în pat într-un mod liniștit și blând.",
      "approach": "gentle_and_consistent",
      "importance": "critical"
    },
    "temperature": {
      "title": "Temperatură optimă pentru somn",
      "description": "Temperatura camerei de somn trebuie să fie redusă treptat cu 0.5 grade pe săptămână, astfel încât la momentul culcării să fie cu 2 grade mai mică decât restul casei. Temperatura optimă pentru somn este între 21-22 grade Celsius.",
      "reductionRate": "0.5 grade/săptămână",
      "targetDifference": "2 grade mai mică decât restul casei",
      "optimalRange": "21-22°C",
      "importance": "high"
    },
    "gentleApproach": {
      "title": "Abordare blândă și liniștită",
      "description": "Dacă copilul vrea să plece, să aprindă becul, să se joace sau orice altceva în timpul rutinei de culcare, trebuie să fie pus înapoi în pat într-un mod liniștit, blând și consistent, fără emoții negative sau frustrări.",
      "importance": "critical"
    }
  },
